<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/bodyfat#"
     xml:base="http://www.semanticweb.org/bodyfat"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://www.semanticweb.org/bodyfat"/>

    <!-- ===================== -->
    <!-- CLASSES -->
    <!-- ===================== -->

    <owl:Class rdf:about="#People"/>
    <owl:Class rdf:about="#Measurement"/>
    <owl:Class rdf:about="#Feature"/>
    <owl:Class rdf:about="#Prediction"/>
    <owl:Class rdf:about="#QualityAssessment"/>
    <owl:Class rdf:about="#BMIClass"/>
    <owl:Class rdf:about="#FatLevel"/>
    <owl:Class rdf:about="#Explanation"/>
    <owl:Class rdf:about="#Recommendation"/>

    <!-- ===================== -->
    <!-- OBJECT PROPERTIES -->
    <!-- ===================== -->

    <owl:ObjectProperty rdf:about="#hasMeasurement">
        <rdfs:domain rdf:resource="#People"/>
        <rdfs:range rdf:resource="#Measurement"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasFeature">
        <rdfs:domain rdf:resource="#People"/>
        <rdfs:range rdf:resource="#Feature"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasPrediction">
        <rdfs:domain rdf:resource="#People"/>
        <rdfs:range rdf:resource="#Prediction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasQuality">
        <rdfs:domain rdf:resource="#People"/>
        <rdfs:range rdf:resource="#QualityAssessment"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasBMIClass">
        <rdfs:domain rdf:resource="#Prediction"/>
        <rdfs:range rdf:resource="#BMIClass"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasFatLevel">
        <rdfs:domain rdf:resource="#Prediction"/>
        <rdfs:range rdf:resource="#FatLevel"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasExplanation">
        <rdfs:domain rdf:resource="#Prediction"/>
        <rdfs:range rdf:resource="#Explanation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasRecommendation">
        <rdfs:domain rdf:resource="#Prediction"/>
        <rdfs:range rdf:resource="#Recommendation"/>
    </owl:ObjectProperty>

    <!-- ===================== -->
    <!-- DATA PROPERTIES -->
    <!-- ===================== -->

    <owl:DatatypeProperty rdf:about="#heightCm">
        <rdfs:domain rdf:resource="#Measurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#weightKg">
        <rdfs:domain rdf:resource="#Measurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#bmiValue">
        <rdfs:domain rdf:resource="#Feature"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#predictedBodyFat">
        <rdfs:domain rdf:resource="#Prediction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#poseVisibility">
        <rdfs:domain rdf:resource="#QualityAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#maskConfidence">
        <rdfs:domain rdf:resource="#QualityAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <!-- ===================== -->
    <!-- INDIVIDUALS (IMPORTANT FOR ONTOGRAF) -->
    <!-- ===================== -->

    <owl:NamedIndividual rdf:about="#person1">
        <rdf:type rdf:resource="#People"/>
        <hasMeasurement rdf:resource="#m1"/>
        <hasFeature rdf:resource="#f1"/>
        <hasPrediction rdf:resource="#p1"/>
        <hasQuality rdf:resource="#q1"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#m1">
        <rdf:type rdf:resource="#Measurement"/>
        <heightCm rdf:datatype="xsd:float">170</heightCm>
        <weightKg rdf:datatype="xsd:float">65</weightKg>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#f1">
        <rdf:type rdf:resource="#Feature"/>
        <bmiValue rdf:datatype="xsd:float">22.5</bmiValue>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#p1">
        <rdf:type rdf:resource="#Prediction"/>
        <predictedBodyFat rdf:datatype="xsd:float">18.2</predictedBodyFat>
        <hasBMIClass rdf:resource="#Normal"/>
        <hasFatLevel rdf:resource="#NormalFat"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#q1">
        <rdf:type rdf:resource="#QualityAssessment"/>
        <poseVisibility rdf:datatype="xsd:float">0.9</poseVisibility>
        <maskConfidence rdf:datatype="xsd:float">0.85</maskConfidence>
    </owl:NamedIndividual>

    <!-- BMI CLASS -->
    <owl:NamedIndividual rdf:about="#Normal"/>
    <owl:NamedIndividual rdf:about="#Overweight"/>

    <!-- FAT LEVEL -->
    <owl:NamedIndividual rdf:about="#NormalFat"/>
    <owl:NamedIndividual rdf:about="#HighFat"/>

</rdf:RDF>